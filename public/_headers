# Cloudflare Pages header rules.
#
# Pages consumes this file as configuration — it is not served as content.
# Every rule here is verifiable from the outside with:
#     curl -sI https://anmolkanitkar.com

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# The CSP is deliberately strict: no inline script, no inline style, no external
# origin except the two Cloudflare Web Analytics hosts. If you ever add a
# third-party embed and it silently fails, check the browser console first —
# that is this policy doing its job, not a bug.

# ---------------------------------------------------------------------------
# Caching
#
# HTML revalidates on every request so a deploy is visible immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# There is no build step, so filenames are not content-hashed. A long max-age
# would strand visitors on stale CSS after a deploy with no way to bust it.
# One hour is the compromise. Only raise this if you add hashed filenames.
/css/*
  Cache-Control: public, max-age=3600
/js/*
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=3600
